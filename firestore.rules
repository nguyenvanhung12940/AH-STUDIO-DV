rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "hainguyenbtm.070589@gmail.com" ||
        request.auth.token.email == "traliendichvucong@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidSurveyResponse(data) {
      return data.keys().hasAll(['surveyId', 'createdAt', 'serviceType', 'submissionMethod', 'ratings', 'improvementArea', 'dataVersion']) 
        && data.surveyId is string
        && data.createdAt == request.time
        && data.serviceType in ["Hộ tịch", "Chứng thực", "Đất đai", "Xây dựng", "Chính sách xã hội", "Khác"]
        && data.submissionMethod in ["Trực tiếp", "Trực tuyến", "Kết hợp"]
        && data.improvementArea in ["Thời gian giải quyết", "Hướng dẫn thủ tục", "Thái độ phục vụ", "Cơ sở vật chất", "Dịch vụ trực tuyến", "Khác"]
        && (data.comment == null || (data.comment is string && data.comment.size() <= 1000))
        && data.dataVersion is int
        && data.ratings is map
        && data.ratings.keys().hasAll(['informationAccess', 'procedureGuidance', 'staffAttitude', 'convenience', 'processingTimeClarity', 'overallSatisfaction']);
    }

    match /surveyResponses/{surveyId} {
      allow create: if isValidId(surveyId) && isValidSurveyResponse(request.resource.data);
      
      // ADMIN can read everything, PUBLIC cannot read individual or list of responses
      allow read: if isAdmin();
      
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console or special script
    }
  }
}
